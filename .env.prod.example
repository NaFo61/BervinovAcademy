# Шаблон для сервера: скопируй в /opt/bervinov-academy/.env и заполни.

# На сервере только этот файл и docker-compose.yml — Docker login НЕ нужен (публичные образы).



DEBUG=False

DJANGO_LOG_LEVEL=INFO

SECRET_KEY=change-me-to-a-long-random-string

SUB_PATH=



# Логин Docker Hub (как в hub.docker.com/u/nafo)

DOCKERHUB_USER=nafo

IMAGE_TAG=latest



DB_ENGINE=django.db.backends.postgresql

DB_NAME=bervinov_academy

DB_USER=bervinov

DB_PASSWORD=change-me-strong-db-password

DB_HOST=db

DB_PORT=5432



ALLOWED_HOSTS=academy.bervinov-miron.ru,161.104.46.236,localhost,127.0.0.1

CSRF_TRUSTED_ORIGINS=https://academy.bervinov-miron.ru,https://161.104.46.236,http://161.104.46.236,http://localhost

CORS_ALLOWED_ORIGINS=https://academy.bervinov-miron.ru,https://161.104.46.236,http://161.104.46.236,http://localhost

USE_X_FORWARDED_HOST=True

FRONTEND_URL=https://academy.bervinov-miron.ru



CELERY_BROKER_URL=redis://redis:6379/0

CELERY_RESULT_BACKEND=redis://redis:6379/0

CHANNEL_LAYERS_REDIS=redis://redis:6379/1



KAFKA_BOOTSTRAP_SERVERS=kafka:29092

KAFKA_TOPIC=code-submissions

KAFKA_TOPIC_CODE_RESULTS=code-submission-results

KAFKA_GROUP_CODE_RESULTS=django-code-submission-results

KAFKA_RESULTS_AUTO_OFFSET_RESET=earliest



WHITEBOARD_ENABLED=True

# Trial/commercial key from https://tldraw.dev (do not commit real key)
TLDRAW_LICENSE_KEY=



LIVEKIT_URL=

LIVEKIT_API_KEY=

LIVEKIT_API_SECRET=



# OAuth (Яндекс ID / VK ID). Redirect URI в кабинетах приложений:

#   https://academy.bervinov-miron.ru/auth-callback

# VK ID (id.vk.com): доверенный redirect URI — тот же URL; auth через id.vk.ru + PKCE.

YANDEX_OAUTH_CLIENT_ID=

YANDEX_OAUTH_CLIENT_SECRET=

VK_OAUTH_CLIENT_ID=

VK_OAUTH_CLIENT_SECRET=



# VK Callback API (сообщество: чат-мост + уведомления)

# URL: https://academy.bervinov-miron.ru/api/vk/webhook/$VK_CALLBACK_SECRET/

VK_GROUP_TOKEN=

VK_GROUP_ID=

VK_CALLBACK_CONFIRMATION=

VK_CALLBACK_SECRET=change-me-long-random



# Web Push (VAPID). Сгенерировать: python -m py_vapid --applicationServerKey

VAPID_PUBLIC_KEY=

VAPID_PRIVATE_KEY=

VAPID_ADMIN_EMAIL=mailto:admin@academy.bervinov-miron.ru



# ИИ-помощник (OpenAI-compatible). Рекомендуем ProxyAPI (рубли, без VPN).

# Docs: https://proxyapi.ru/docs/overview — только в .env на сервере, не в git.

ASSISTANT_LLM_ENABLED=false

OPENAI_API_KEY=

OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

OPENAI_MODEL=gpt-4o-mini



# Selectel S3 — видеоуроки (приватный бакет + signed URL для Pro).

# Ключи только в .env на сервере, не в git.

USE_S3=true

AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

AWS_STORAGE_BUCKET_NAME=bervinov-academy-videos

AWS_S3_ENDPOINT_URL=https://s3.ru-6.storage.selcloud.ru

AWS_S3_REGION_NAME=ru-6

AWS_S3_ADDRESSING_STYLE=path

AWS_QUERYSTRING_AUTH=true

AWS_QUERYSTRING_EXPIRE=3600

DATA_UPLOAD_MAX_MEMORY_SIZE=536870912

# Сессия входа: access 15 минут, refresh 180 дней («Запомнить меня»).
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=180

# Почта Selectel SMTP (коды сброса пароля и подтверждения email).
# Домен должен быть привязан в панели Selectel + DNS TXT.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.selcloud.ru
EMAIL_PORT=1127
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=Bervinov Academy <noreply@bervinov-miron.ru>
