          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/push/vapid/"
          }
        },
        {
          "name": "Push vapid — authenticated, no private key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const raw = pm.response.text().toLowerCase();",
                  "pm.test('no private key leak', () => {",
                  "  pm.expect(raw).to.not.include('private');",
                  "  pm.expect(j).to.have.property('configured');",
                  "  pm.expect(j).to.have.property('public_key');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
