          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 after blacklist', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh/"
          }
        }
